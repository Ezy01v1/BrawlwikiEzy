# URL interna de la API (solo la usa el servidor de Next; nunca el navegador)
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# URL pública del sitio (metadatos, imágenes OG y `Origin` de los requests que modifican;
# tiene que coincidir con PUBLIC_SITE_URL de la API o esta responde 403)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
